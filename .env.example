# Copy this to .env for local dev (Vercel CLI: `vercel env pull`), or set
# these directly in the Vercel project's Environment Variables settings.
# Never commit a real .env file — it's already in .gitignore.

# Required. Powers card identification from the video frame (Gemini vision).
GEMINI_API_KEY=

# Optional. Defaults to gemini-3.6-flash if unset. Verify this is still a
# valid, non-deprecated model string before relying on the default.
GEMINI_MODEL=

# Optional but recommended for English cards. pokemontcg.io works without
# a key (1,000 req/day, 30/min) but a FREE key (register at
# pokemontcg.io/register — no payment) raises that to 20,000/day, which
# meaningfully improves reliability. Not required: English lookups
# automatically fall back to PokemonPriceTracker below if pokemontcg.io
# fails, so this is a reliability/speed improvement, not a hard dependency.
POKEMONTCG_API_KEY=

# Required. Powers Japanese card lookup, graded-slab pricing, AND serves as
# the automatic fallback for English lookups if pokemontcg.io is down.
# Sent as `Authorization: Bearer <key>`.
POKEMONPRICETRACKER_API_KEY=

# Optional override if PokemonPriceTracker's endpoint path changes.
# Defaults to https://www.pokemonpricetracker.com/api/v2/prices
PPT_BASE_URL=
